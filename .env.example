# Скопируйте в .env и заполните значения (файл .env в Git не попадает)
# Windows:  copy .env.example .env
# Linux:   cp .env.example .env

# --- Flask / сайт ---
SECRET_KEY=change-me-to-random-string-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
# DATABASE_URL=sqlite:///site.db

# --- ProxyAPI (чат-виджет RAG, работает из РФ без VPN) ---
# Ключ: https://console.proxyapi.ru/keys
# Без ключа сайт и формы работают, но /chat вернёт ошибку 503
PROXYAPI_KEY=your-proxyapi-key-here

# Адрес OpenAI-совместимого API ProxyAPI (обычно менять не нужно)
# PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Модели (список в кабинете ProxyAPI; по умолчанию — экономичные)
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_CHAT_MODEL=gpt-4o-mini
# CHAT_MAX_HISTORY=10

# Устаревшее имя ключа (если уже есть OPENAI_API_KEY — тоже сработает)
# OPENAI_API_KEY=
